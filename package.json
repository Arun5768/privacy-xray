{
  "name": "privacy-xray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "See which third parties receive your wallet address, prove it, and block it. Everything stays on your device.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "demo": "node demo/serve.mjs",
    "test": "node --test test/detect.test.ts",
    "e2e": "npm run build && node test/e2e.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "publish:arkiv": "node --env-file=.env scripts/publish-arkiv.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@noble/hashes": "2.4.0",
    "tldts": "7.4.19",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.43.1"
  }
}
